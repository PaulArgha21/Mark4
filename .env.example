# ══════════════════════════════════════════════════
# APRDITE — Environment Variables
# Copy to .env.local and fill in real values
# ══════════════════════════════════════════════════

# ── DATABASE (Supabase PostgreSQL) ────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── REDIS (Upstash) ──────────────────────────────
UPSTASH_REDIS_REST_URL="https://[YOUR_REDIS].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_TOKEN]"

# ── JWT SECRETS ───────────────────────────────────
JWT_ACCESS_SECRET="your-customer-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-customer-refresh-secret-min-32-chars"
JWT_EMPLOYEE_ACCESS_SECRET="your-employee-access-secret-min-32-chars"
JWT_EMPLOYEE_REFRESH_SECRET="your-employee-refresh-secret-min-32-chars"

# ── CLOUDFLARE R2 (Media Storage) ─────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="aprdite-media"
R2_PUBLIC_URL="https://media.aprdite.com"

# ── RAZORPAY ──────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ── EMAIL (Resend) ────────────────────────────────
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="noreply@aprdite.com"

# ── ML SERVICE ────────────────────────────────────
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_SECRET="your-ml-service-secret"

# ── APP ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REVALIDATE_SECRET="your-revalidate-secret"
CRON_SECRET="your-cron-secret"

# ── PUSH NOTIFICATIONS (Web Push) ─────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# ── MONITORING ────────────────────────────────────
SENTRY_DSN="https://xxx@sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"

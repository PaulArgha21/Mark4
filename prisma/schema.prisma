// ═══════════════════════════════════════════════════════════
// CHATBOT — AI Support Conversations (E2E Encrypted)
// ═══════════════════════════════════════════════════════════

model ChatSession {
  id            String            @id @default(cuid())
  customerId    String
  customer      User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        ChatSessionStatus @default(ACTIVE)
  context       Json?             // { selectedOrderId, lastIntent, resolvedIntents[] }
  summary       String?           @db.Text // AI-generated session summary
  satisfaction  Int?              // 1-5 rating from customer
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  messages ChatMessage[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id          String        @id @default(cuid())
  sessionId   String
  session     ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender      ChatSender
  encrypted   String        @db.Text  // AES-256-GCM encrypted content
  iv          String        // initialization vector (hex)
  tag         String        // GCM auth tag (hex)
  intent      String?       // detected intent category
  sentiment   ChatSentiment @default(NEUTRAL)
  confidence  Float?        // intent match confidence 0-1
  metadata    Json?         // { orderData, paymentData, suggestedActions, etc. }
  createdAt   DateTime      @default(now())

  @@index([sessionId])
  @@index([intent])
  @@index([createdAt])
}

model ChatPattern {
  id          String   @id @default(cuid())
  intent      String   // e.g. 'track_order', 'refund_request'
  pattern     String   @db.Text  // customer input text
  response    String?  @db.Text  // successful response that resolved the query
  confidence  Float    @default(1.0)
  usageCount  Int      @default(1)
  wasHelpful  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([intent])
  @@index([usageCount])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([source, eventType])
  @@index([processed])
  @@index([createdAt])
}

  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  sku              String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  costPerUnit      Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
}

model StockAdjustment {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  sku          String
  previousQty  Int
  newQty       Int
  delta        Int
  reason       String
  notes        String?
  adjustedById String?
  createdAt    DateTime       @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model WarehouseLocation {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  pincode   String?
  city      String?
  state     String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([pincode])
}

// ═══════════════════════════════════════════════════════════
// SHIPPING & PINCODE DIRECTORY
// ═══════════════════════════════════════════════════════════

enum ShippingZoneType {
  METRO
  TIER1
  TIER2
  TIER3
  RURAL
  REMOTE
  NON_SERVICEABLE
}

model ShippingZone {
  id          String           @id @default(cuid())
  name        String           @unique
  type        ShippingZoneType
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  pincodes    PincodeEntry[]
  originPolicies      ShippingPolicy[] @relation("OriginZone")
  destinationPolicies ShippingPolicy[] @relation("DestinationZone")
}

model PincodeEntry {
  id            String           @id @default(cuid())
  pincode       String           @unique
  city          String
  district      String?
  state         String
  stateCode     String?
  zoneId        String
  zone          ShippingZone     @relation(fields: [zoneId], references: [id])
  latitude      Float?
  longitude     Float?
  isServiceable Boolean          @default(true)
  isCODAvailable Boolean         @default(true)
  deliveryNote  String?
  createdAt     DateTime         @default(now())

  @@index([pincode])
  @@index([zoneId])
  @@index([state])
  @@index([city])
}

model ShippingPolicy {
  id                  String       @id @default(cuid())
  originZoneId        String
  originZone          ShippingZone @relation("OriginZone", fields: [originZoneId], references: [id])
  destinationZoneId   String
  destinationZone     ShippingZone @relation("DestinationZone", fields: [destinationZoneId], references: [id])
  minDays             Int
  maxDays             Int
  baseCost            Float        @default(0)
  perKgCost           Float        @default(0)
  freeShippingAbove   Float?
  isExpressAvailable  Boolean      @default(false)
  expressMinDays      Int?
  expressMaxDays      Int?
  expressCost         Float?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([originZoneId, destinationZoneId])
  @@index([originZoneId])
  @@index([destinationZoneId])
}

// ═══════════════════════════════════════════════════════════
// SUPPORT & FAQ
// ═══════════════════════════════════════════════════════════

model SupportTicket {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  email      String
  subject    String
  message    String       @db.Text
  status     TicketStatus @default(OPEN)
  priority   String       @default("MEDIUM")
  assignedTo String?
  orderId    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@index([status])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  isStaff   Boolean       @default(false)
  authorId  String?
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
}

model ProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String   @db.Text
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  answers ProductAnswer[]

  @@index([productId])
}

model ProductAnswer {
  id         String          @id @default(cuid())
  questionId String
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String          @db.Text
  isOfficial Boolean         @default(false)
  authorId   String?
  createdAt  DateTime        @default(now())

  @@index([questionId])
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Notification {
